# Local development defaults. Copied to .env by `make up`. Never put real secrets here.
ENVIRONMENT=local
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_USER=profilo
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=profilo
DATABASE_URL=postgresql+asyncpg://profilo:local-dev-only@db:5432/profilo
TEST_DATABASE_URL=postgresql+asyncpg://profilo:local-dev-only@db:5432/profilo_test

VALKEY_URL=redis://valkey:6379/0

SMTP_HOST=mailpit
SMTP_PORT=1025
