# Local development proxy: http://localhost:8080
:80 {
	encode zstd gzip

	# The servers' fallback policy (infra/server/Caddyfile), so E2E runs under it too: pages
	# send their own with a script nonce (client/src/proxy.ts).
	header ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# Request size: 10 MB images (plus multipart overhead), 1 MB for everything else.
	@upload path /api/v1/me/profile/images/*
	request_body @upload {
		max_size 11MB
	}
	@other not path /api/v1/me/profile/images/*
	request_body @other {
		max_size 1MB
	}

	@api path /api/* /media/* /health /ready
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy client:3000
	}
}
