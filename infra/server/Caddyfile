# Staging and production reverse proxy. Domain and TLS mode come from the environment:
#   DOMAIN        e.g. staging.profilo.pl
#   TLS_MODE      acme (default, Let's Encrypt on 80/443) | internal (local test VM)
#                 | proxied (shared host: the host's nginx terminates TLS, see
#                   compose.proxied.yml and nginx-profilo.conf)
#   SITE_ADDRESS  what Caddy serves: the domain (compose.yml default), http://:80 when proxied
#   TRUSTED_PROXIES  addresses whose X-Forwarded-* headers are believed (proxied: the
#                 Docker gateway the host's nginx connects through); nobody by default
#   ROBOTS_TAG    "noindex, nofollow" on staging, "all" on production
#   ACME_EMAIL    contact for Let's Encrypt expiry notices
{
	email {$ACME_EMAIL:unused@example.invalid}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# Snippets api_upstream and client_upstream (deploy.sh).
import upstreams.caddy

(tls_acme) {
}

(tls_internal) {
	tls internal
}

# TLS is terminated by the host's reverse proxy; HSTS and the other headers are still set
# here and pass through it.
(tls_proxied) {
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-Robots-Tag "{$ROBOTS_TAG:noindex, nofollow}"
		-Server
	}
	# Pages cannot be framed, except the editor preview (/podglad) and the landing's example
	# page (/przyklad), both by the same origin only.
	@framable path /podglad /przyklad
	@not_framable not path /podglad /przyklad
	header @not_framable Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	header @framable Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
}

{$SITE_ADDRESS} {
	import tls_{$TLS_MODE:acme}
	import security_headers
	encode zstd gzip

	# Request size: 10 MB images (plus multipart overhead), 1 MB for everything else.
	@upload path /api/v1/me/profile/images/*
	request_body @upload {
		max_size 11MB
	}
	@other not path /api/v1/me/profile/images/*
	request_body @other {
		max_size 1MB
	}

	@api path /api/* /media/* /health /ready
	# The live colour (api-blue/api-green, client-…) comes from upstreams.caddy, written by
	# deploy.sh next to this file; a release switch is a graceful reload.
	handle @api {
		import api_upstream
	}

	handle {
		import client_upstream
	}

	log {
		# Access log with IP addresses: kept 14 days (privacy policy), in the caddy_data volume.
		output file /data/logs/access.log {
			roll_interval 24h
			roll_size 50MiB
			roll_keep_for 336h
		}
		# One-time tokens in links (/potwierdz-email, /nowe-haslo) never reach the logs.
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}
